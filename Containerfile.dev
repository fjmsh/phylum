# syntax=docker/dockerfile:1.4
#
# Containerfile for Phylum Development
#
# Allows for containerized development in case language toolchains
# are not set up locally.
#
# Usage: podman/docker compose -f compose.dev.yml up --build


# ============================================
# Stage: Build the API server
# ============================================
FROM docker.io/golang:alpine AS api_builder
RUN apk update && apk add --no-cache build-base ffmpeg-dev vips-dev
WORKDIR /src
COPY server/go.mod server/go.sum .
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY server/ .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -o /bin/phylum cmd/phylum.go



# ============================================
# Stage: Build the Web App
# ============================================
FROM docker.io/shroff12/flutter-web:3.47.3 AS webapp_builder
WORKDIR /src
COPY client/web ./web
COPY client/assets ./assets
COPY client/pubspec.yaml client/pubspec.lock .
RUN --mount=type=cache,target=/root/.pub-cache flutter pub get
COPY client/lib ./lib
RUN --mount=type=cache,target=/root/.pub-cache dist/web.sh -b


# ============================================
# Final Stage: Server
# ============================================
FROM docker.io/alpine:latest AS server
RUN apk add --no-cache ffmpeg-dev vips-tools vips-poppler font-noto libreoffice
ENV PATH="$PATH:/app"
ENV PHYLUM_SERVER__WEB_APP_SRC="/app/web"
COPY --from=api_builder /bin/phylum /app/phylum
COPY --from=webapp_builder /src/build/web /app/web
WORKDIR /var/lib/phylum
ENTRYPOINT ["phylum"]
CMD ["serve", "--debug"]
