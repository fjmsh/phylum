# ============================================
# compose.yml
# ============================================

## Which image tag to use.
# PHYLUM_IMAGE_TAG=latest

## Location of all container data
# DATA_ROOT=./data

## Location of phylum data (relative to ${DATA_ROOT})
# PHYLUM_DATA_LOCATION=phylum

## Location of postgres data (relative to ${DATA_ROOT})
# PG_DATA_LOCATION=postgres

# ============================================
# phylum config
# ============================================
# For a full list of configuration parameters see the config.defaults.yml at
# https://codeberg.org/shroff/phylum/src/branch/main/server/internal/config/config.defaults.yml
#
# You can use PHYLUM_* environment variables to override any config entry.
# Use __ to delimit keys; for example:
#
# server:
#   port: 2448
#
# would be PHYLUM_SERVER__PORT=2448

## Database config
# PHYLUM_DB__NAME=phylum
# PHYLUM_DB__USER=phylum
PHYLUM_DB__PASSWORD=<CHANGE-ME-DO-NOT-USE-AS-IS>
